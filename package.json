{
  "name": "ai-workflow-runner",
  "version": "1.7.0",
  "description": "Run AI workflows with Node.js, Python, and Java runtime support",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --sourcemap",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPatterns='src/.*\\.spec\\.ts$' --coverage",
    "test:integration": "jest --testPathPatterns=integration --runInBand",
    "test:unit:ci": "jest --testPathPatterns='src/.*\\.spec\\.ts$' --coverage --reporters=default --reporters=jest-junit",
    "test:integration:ci": "jest --testPathPatterns=integration --runInBand --reporters=default --reporters=jest-junit",
    "test:e2e": "jest --testPathPatterns=e2e --runInBand --testTimeout=180000",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "lint:ci": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0 --format json --output-file reports/eslint-report.json",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arch-playground/ai-workflow-runner.git"
  },
  "keywords": [
    "github-action",
    "ai",
    "workflow",
    "automation"
  ],
  "author": "TanNT",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@opencode-ai/sdk": "^1.18.25"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vercel/ncc": "^0.45.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-junit": "^16.0.0",
    "js-yaml": "^4.2.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
